FROM python:3.12-slim

WORKDIR /app

# Install system dependencies for ephem (astronomical calculations)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY packages/bazi-engine/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY packages/bazi-engine/ .

# Create non-root user
RUN adduser --disabled-password --gecos '' baziuser
USER baziuser

# Internal-only service (Railway private networking). Binds $PORT so the
# platform can assign it; defaults to 8000. The API reaches it via
# BAZI_ENGINE_URL=http://<engine-service>.railway.internal:$PORT — never public.
# Bind :: (IPv6 wildcard) — Railway's *.railway.internal DNS resolves to IPv6
# ONLY, so --host 0.0.0.0 (IPv4-only) is unreachable over private networking.
# On Debian dual-stack (bindv6only=0) an IPv6 wildcard also accepts IPv4.
ENV PORT=8000
EXPOSE 8000

# `exec` is redundant TODAY and kept deliberately: `sh -c` with a single
# command already auto-execs (measured), so uvicorn is PID 1 and receives
# SIGTERM, which is what makes its graceful shutdown work. That's an
# optimisation we are relying on, not a guarantee — chain one `&&` in front
# and the shell stays PID 1 and swallows the signal silently. Dockerfile.api
# had exactly that bug. Stating it costs nothing.
# M3 — two worker PROCESSES, not just threads.
#
# The `def` handlers in main.py move CPU work off the event loop, which buys
# LATENCY ISOLATION: /health answers while a calculation runs. It does NOT buy
# parallelism — those threads still contend for one GIL, so total throughput is
# unchanged. Separate processes have separate GILs, which is where the actual
# concurrency comes from. Both halves of M3 are needed and they do different
# things.
#
# ⚠️ Sizing: each worker is a full Python heap with its own copy of the loaded
# data tables and its own `_flow_year_cache`, so N workers means N times the
# memory and a diluted cache hit rate. 2 is deliberate, not a placeholder —
# raise it only with the memory ceiling in view.
CMD ["sh", "-c", "exec uvicorn app.main:app --host :: --port ${PORT:-8000} --workers ${WEB_CONCURRENCY:-2}"]
