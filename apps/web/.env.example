# ===========================================
# Bazi Platform — Web (Next.js) Environment
# Copy this file to apps/web/.env.local and fill in values.
#
# IMPORTANT: Next.js reads env from THIS app directory (apps/web/.env.local),
# NOT the monorepo-root .env. A var documented only in the root .env.example
# will NOT reach the web app unless it is also set here.
#
# Vars prefixed NEXT_PUBLIC_ are inlined into the browser bundle at build/start
# time — never put a real secret behind a NEXT_PUBLIC_ name. Restart `next dev`
# after changing any of these (NEXT_PUBLIC_ vars are read at server start).
# ===========================================

# ---- Clerk Authentication ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."            # secret — used by middleware / server components

# Clerk routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# ---- API (NestJS) base URL ----
NEXT_PUBLIC_API_URL="http://localhost:4000"

# ---- Bazi engine ----
# ⚠️ M10: the web app no longer talks to the Python engine AT ALL. The free
# chart preview (`app/api/bazi-calculate/route.ts`) proxies through NestJS, which
# owns the only keyed engine client in the repo.
#
# So do NOT set ENGINE_KEY on the web service. It would be a live secret with no
# reader — one more copy to rotate, and a misleading signal that this service is
# an engine caller when `ENGINE_REQUIRE_KEY` is flipped (B3-b). The variable is
# intentionally absent rather than blank.
#
# BAZI_ENGINE_URL is likewise unused here now; NestJS holds it.

# ---- Stripe (publishable key only — the secret key lives in the API env) ----
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ---- Canonical public URL (M9) ----
# Feeds canonical/OpenGraph URLs (layout.tsx), the sitemap, and robots.txt via
# app/lib/site-url.ts. No trailing slash — one is stripped if present.
#
# Unset falls back to http://localhost:3000. That is deliberate: the previous
# fallback was `https://bazi-platform.com`, a domain we do NOT own, so every
# canonical tag and the `Sitemap:` line pointed at a third party. A localhost
# fallback is obviously wrong to anyone who looks, which is the point.
#
# Related but NOT the same: the API's WEB_ORIGINS (root .env.example) is the
# Stripe redirect allowlist. In production both name the same site; they are
# separate because one is SEO metadata and the other is a security control.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Observability (optional; unset = disabled) ----
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

# ---- Clerk azp allowlist (server-side; same value as the API service) ----
# NOT NEXT_PUBLIC_: read in middleware. Empty = no check. ⚠️ Leave UNSET until
# the web app has a deployed origin — a wrong value 401s every session at once.
CLERK_AUTHORIZED_PARTIES=""

# ---- Cloudflare R2 — dashboard banner image host ----
# Host of the R2 bucket's public URL (pub-<hash>.r2.dev or a custom domain),
# WITHOUT protocol or trailing slash. next.config.js injects this into BOTH the
# CSP img-src directive AND images.remotePatterns.
#
# REQUIRED for the dashboard banner: if empty, the CSP omits the R2 host and the
# browser silently blocks the banner <img> — HeroBanner renders broken/blank
# images even though the files themselves return HTTP 200. Must match the host
# embedded in your stored banner image URLs (R2_PUBLIC_BASE_URL on the API side).
NEXT_PUBLIC_R2_PUBLIC_HOST=""

# ---- Development Overrides ----
# "true" only for dev without AI keys (shows mock AI data on direct engine calls)
NEXT_PUBLIC_USE_MOCK_AI=""
