{
  "expo": {
    "name": "天命",
    "slug": "tianming",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tianming",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF3E0",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tianming.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "zh-Hant",
        "NSPhotoLibraryAddUsageDescription": "需要存取相簿以儲存您的命盤分享圖片。"
      },
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF3E0"
      },
      "package": "com.tianming.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-image",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      "expo-apple-authentication",
      "expo-updates",
      "./plugins/with-ios-development-region",
      "./plugins/with-pod-deployment-target",
      "@sentry/react-native",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF3E0",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b7c274f0-ce98-42ca-93c9-cb5af4faff3a"
      }
    },
    "owner": "tian-ming",
    "locales": {
      "zh-Hant": "./locales/zh-Hant.json",
      "zh-Hans": "./locales/zh-Hans.json"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/b7c274f0-ce98-42ca-93c9-cb5af4faff3a"
    }
  }
}
