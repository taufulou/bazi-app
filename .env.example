# ===========================================
# Bazi Platform - Environment Variables
# Copy this file to .env and fill in values
# ===========================================

# ---- Database ----
# ⚠️ Placeholder — do NOT paste your real password here. This file is COMMITTED.
# It previously carried the actual local dev password byte-for-byte, which the
# 1D audit found still authenticated against the running Postgres. Localhost
# only, but that database holds real birth-profile PII.
DATABASE_URL="postgresql://bazi_user:CHANGE_ME@localhost:5432/bazi_platform"
REDIS_URL="redis://localhost:6379"

# ---- Clerk Authentication ----
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."
# B5 — comma-separated allowlist for the JWT `azp` claim (the frontend origins
# whose tokens this API accepts). Set on BOTH the API and web services.
# EMPTY = NO CHECK: any token minted for any origin on this Clerk instance is
# accepted. Required before launch; the API logs a warning at boot while unset.
#
# Value = the origin exactly as Clerk emits it: lowercase scheme + host, plus the
# port when non-default, and NO trailing slash. Dev needs BOTH localhost and
# 127.0.0.1 (the HSTS dodge). Do not use a bare host — Clerk's own docs show one
# and it matches nothing.
#
# Confirm the real value instead of guessing: sign in, run
#   await window.Clerk.session.getToken()
# in the console, and decode the middle JWT segment. Native (mobile) tokens carry
# no `azp` at all and are unaffected by this list.
CLERK_AUTHORIZED_PARTIES="http://localhost:3000,http://127.0.0.1:3000"

# ---- AI Providers ----
ANTHROPIC_API_KEY="sk-ant-..."
OPENAI_API_KEY="sk-..."
GOOGLE_AI_API_KEY="..."

# ---- Stripe Payments ----
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---- S2: AI spend ledger + circuit breaker ----
# The ONLY ceiling on AI spend that this application controls. The account also
# carries a self-imposed $500/month limit, but that is an all-at-once cliff with
# no per-day smoothing; these defaults sit below it deliberately so the graceful
# ceiling is always the one reached first.
#
# At 80% of either cap: a Sentry warning. At 100%: new generation returns a typed
# 503 `AI_SPEND_CAP` while CACHED reads keep working.
#
# Spend is accumulated in Redis under Asia/Taipei day keys (a UTC day would roll
# at 08:00 local, splitting the busiest hours across two buckets).
AI_DAILY_SPEND_LIMIT_USD=50
AI_MONTHLY_SPEND_LIMIT_USD=400
# Rollback switch. `0` disables the breaker — spend is still RECORDED, nothing is
# refused. Use it to restore service while diagnosing; do not leave it off.
AI_SPEND_BREAKER_ENABLED=1

# ---- S4: per-user daily quotas ----
# S1 (concurrency) and S2 (spend) are GLOBAL — neither stops one account
# consuming the whole budget and denying everyone else. These are the per-user
# bound, set well above genuine use: they exist to cap abuse, not behaviour.
# Counted per Asia/Taipei day, on ATTEMPT (a failed generation still costs
# tokens, and refunding on failure would make the quota gameable).
# Over quota returns a typed 429 `QUOTA_EXCEEDED`. `0` disables one quota.
QUOTA_READINGS_PER_DAY=20
QUOTA_CHAT_MESSAGES_PER_DAY=200
QUOTA_FORTUNE_PER_DAY=30

# ---- Bazi Engine ----
BAZI_ENGINE_URL="http://localhost:5001"

# B3-a — shared secret between the API/web and the Python engine.
#
# TWO doors: the engine and the NestJS API. ⚠️ It used to be three — the Next.js
# web app held its own key for the free chart preview — but M10 rerouted that
# route through NestJS and deleted the web-side client, so the web service must
# NOT be given ENGINE_KEY: it would be a live secret with no reader, and a
# misleading signal about who calls the engine when B3-b flips. See
# `apps/web/.env.example`. Set ONE Railway shared/project variable named
# ENGINE_KEY and reference it from the engine and the API, so they cannot drift.
# Generate with:
#     openssl rand -base64 32
#
# Leave it blank locally: the engine ships in OBSERVE mode, so an unkeyed call
# is counted (grep Railway logs for ENGINE-AUTH-ROLLUP) but never refused.
ENGINE_KEY=""
#
# Engine-side only, and only during a rotation. The engine accepts ANY key in
# this comma-separated list, which is what makes add-new → redeploy both →
# remove-old possible with no window where a live caller is refused. When unset
# the engine falls back to ENGINE_KEY.
#   ENGINE_KEYS="<old>,<new>"
#
# Engine-side only. Set to 1 to REJECT unkeyed callers (B3-b). Do not flip this
# until the pre-flight exercise in docs/security/audit-2026-08.md has shown a
# keyed request on every endpoint — fail-closed means an unkeyed caller you
# forgot goes down, not degrades.
#   ENGINE_REQUIRE_KEY=0

# ---- Cloudflare R2 (dashboard banner image uploads) ----
# Optional — the app boots without these; the admin banner /upload endpoint
# fails loudly when unset. Create an R2 bucket with public access + an API
# token (Object Read/Write). R2_PUBLIC_BASE_URL is the bucket's public URL
# (pub-<hash>.r2.dev or a custom domain) WITHOUT a trailing slash.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="bazi-banners"
R2_PUBLIC_BASE_URL=""
# Web (next.config.js) — host of R2_PUBLIC_BASE_URL, added to CSP img-src +
# images.remotePatterns. e.g. "pub-<hash>.r2.dev" or "cdn.example.com".
# REQUIRED for admin banner images: if empty, the CSP omits the R2 host and the
# browser blocks the banner <img> (HeroBanner shows broken images even though the
# files return HTTP 200). Must match the host in your banner image URLs.
# ⚠️ Next.js reads apps/web/.env.local, NOT this root .env — this var must be
# set there. See apps/web/.env.example for the full web env template.
NEXT_PUBLIC_R2_PUBLIC_HOST=""

# ---- App Config ----
NODE_ENV="development"
PORT=4000
CORS_ORIGINS="http://localhost:3000,http://localhost:8081"

# ---- Stripe redirect allowlist (M9) ----
# Comma-separated origins Stripe may send a paying customer back to
# (successUrl / cancelUrl / returnUrl). Relative paths sent by the browser are
# resolved against the FIRST entry, so order matters — put the canonical origin
# first.
#
# SEPARATE from CORS_ORIGINS on purpose: CORS lists every client allowed to READ
# a response and includes dev tooling (the Expo dev server on :8081). Adding a
# dev origin there must not silently widen where we can bounce a customer after
# payment.
#
# Unset falls back to http://localhost:3000 alone, which fails CLOSED in
# production: a deployed origin is not localhost, so checkout returns 400 rather
# than redirecting somewhere unintended. The API warns at boot when it falls back.
WEB_ORIGINS="http://localhost:3000"

# ---- Development Overrides ----
# Set to "true" only for development without AI keys (shows mock AI data on direct engine calls)
NEXT_PUBLIC_USE_MOCK_AI=""

# ---- Sentry Error Tracking ----
SENTRY_DSN=""

# ---- PostHog Analytics ----
POSTHOG_API_KEY=""
POSTHOG_HOST="https://app.posthog.com"

# ---- API docs ----
# Publishes the OpenAPI document at /api/docs. OPT-IN, and deliberately NOT
# derived from NODE_ENV: app.module.ts validates config with a Joi
# .default('development') for NODE_ENV and @nestjs/config writes that back into
# process.env, so a host that sets nothing still reads as development. Set this
# in local .env only; never in a deployed environment.
ENABLE_SWAGGER=true

# ---------------------------------------------------------------------------
# M6 — graceful shutdown (API). All optional; the defaults below are used when
# unset, and a non-numeric or negative value falls back rather than disabling
# the drain. Worst-case total must stay inside the platform's SIGKILL deadline.
# ---------------------------------------------------------------------------
# Time for the load balancer to observe /health/ready returning 503 and stop
# routing to this instance before we start aborting anything.
SHUTDOWN_DRAIN_DELAY_MS=3000
# How long already-running AI streams get to finish on their own. Exits early
# the moment the last one ends, so this is a ceiling, not a fixed cost.
SHUTDOWN_STREAM_GRACE_MS=10000
# Lets aborted streams flush their final SSE frame before the server closes.
SHUTDOWN_SETTLE_MS=500

# ---------------------------------------------------------------------------
# M2 + M8 — replicas. ⚠️ MUST be changed IN LOCKSTEP with the platform's
# replica count; a container cannot detect how many siblings it has.
# TWO subsystems divide by it:
#   • AI concurrency pools are in-memory (per process) but sized from SPEND
#     (per fleet) — scale to 2 without updating this and the burn ceiling
#     silently doubles.
#   • The Prisma pool is per process, so replicas x DATABASE_CONNECTION_LIMIT
#     must stay under Postgres max_connections (warned at boot).
# Unset, garbage, or <1 all mean 1 — the safe direction, i.e. old behaviour.
# ---------------------------------------------------------------------------
REPLICA_COUNT=1

# ---------------------------------------------------------------------------
# M2 — Prisma connection pool, per process. Unset, Prisma defaults to
# num_physical_cpus*2+1 and reads the HOST's core count inside a container,
# which routinely means 17-65 connections per instance. A `connection_limit`
# already present in DATABASE_URL beats this (the connection string stays the
# operator's lever). Check the real ceiling with: SHOW max_connections;
# ---------------------------------------------------------------------------
DATABASE_CONNECTION_LIMIT=10
